pkgname=dotlinker-bin
pkgver=0.3.1
pkgrel=1
pkgdesc='Symlink manager for modular dotfiles'
arch=('x86_64')
url='https://github.com/delfianto/dotlinker'
license=('MIT')
depends=('glibc' 'libgcc')
provides=("dotlinker=$pkgver")
conflicts=('dotlinker')
options=('!strip' '!debug')
_archive="dotlinker-v$pkgver-linux-x86_64"
source=("$url/releases/download/v$pkgver/$_archive.tar.gz")
sha256sums=('48ac859fa775f459a8ac231a0a8fd31a522db92d8bde5ba0523366146579e8f4')

package() {
    cd "$srcdir/$_archive"
    install -Dm0755 dotlinker "$pkgdir/usr/bin/dotlinker"
    install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
